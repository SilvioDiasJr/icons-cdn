{
  "name": "@silviodiasjr/icons-native",
  "version": "0.6.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilvioDiasJr/icons-cdn.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react-native,react-native-svg",
    "prepare": "tsup src/index.ts --format cjs,esm --dts --clean --external react-native,react-native-svg",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react-native,react-native-svg",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=14"
  },
  "devDependencies": {
    "@silviodiasjr/icons-core": "workspace:*",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-native": "^0.73",
    "@vitejs/plugin-react": "^4.0.0",
    "happy-dom": "^13.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
